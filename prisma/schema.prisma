// Telecom Dashboard — Prisma Schema
// Models mirror domain entities from ARCHITECTURE.md §2.1–2.6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// §2.1 User (ПИН, имя клиента)
model UserProfile {
  id        String   @id // PIN code (e.g. "039103")
  fullName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())

  services        Service[]
  transactions    Transaction[]
  supportTickets  SupportTicket[]
}

// §2.2 Balance (баланс и статус оплаты)
model Balance {
  id          String    @id @default(cuid())
  amount      Float
  currency    String
  paidUntil   DateTime?
  isPaid      Boolean   @default(false)
  lastUpdated DateTime  @default(now())
}

// §2.3 Service (активная услуга)
model Service {
  id             String  @id @default(cuid())
  name           String
  category       String
  cost           Float
  status         String  // active · expired · paused · error
  iconUrl        String?
  warningMessage String?
  billingCycle   String? // e.g. "30 days"
  userId         String

  user         UserProfile  @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

// §2.4 Transaction (операция в истории)
model Transaction {
  id               String   @id @default(cuid())
  type             String   // topUp · payment · refund · bonus
  amount           Float
  description      String
  date             DateTime
  status           String   // success · pending · failed
  relatedServiceId String?
  userId           String

  user    UserProfile @relation(fields: [userId], references: [id])
  service Service?   @relation(fields: [relatedServiceId], references: [id])
}

// §2.5 NewsItem (новости)
model NewsItem {
  id          String   @id @default(cuid())
  title       String
  summary     String
  imageUrl    String?
  publishedAt DateTime
  readCount   Int?
  tags        String   // comma-separated tags
}

// §2.6 SupportTicket (обращение в поддержку)
model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  description String
  status      String   // open · inProgress · resolved · closed
  createdAt   DateTime @default(now())
  replyCount  Int      @default(0)
  userId      String

  user UserProfile @relation(fields: [userId], references: [id])
}
