# === Starlink .env ===
# Скопируйте этот файл в .env и заполните значения.
# .env уже в .gitignore и не попадёт в коммиты.

# Основной API (биллинг, баланс, транзакции, услуги)
API_BASE_URL=http://10.0.2.2:3000/api

# СБП API (отдельный эндпоинт для формирования QR и проверки статуса)
# Если пустой - используется API_BASE_URL
SBP_API_URL=

# Платёжный шлюз РСБ Эком (прямые URL к шлюзу для card/register и card/status)
# Если пустые - платёжные запросы идут через API_BASE_URL
RSB_PAYMENT_URL=
RSB_REGISTER_URL=

# РСБ Эком (учётные данные мерчанта)
RSB_MERCHANT_NAME=
RSB_TERMINAL_ID=
RSB_MERCHANT_ID=
RSB_SECRET_KEY=

# Firebase Cloud Messaging (server key для отправки пушей)
# Получить: Firebase Console -> Project Settings -> Cloud Messaging -> Server key
FCM_SERVER_KEY=
